  id_task_applicants        String               @id @default(uuid())
  id_status_task_applicants String
  id_worker                 String
  id_tasks                  String
  applied_at                DateTime             @default(now())
  apply_count               Int                  @default(1)
  alasan_penolakan          String?
  pesan                     String?
  worker_confirmed          Boolean              @default(false)
