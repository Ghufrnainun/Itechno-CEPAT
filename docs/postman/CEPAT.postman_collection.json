  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User Baru",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{reg_email}}\",\n  \"password\": \"Password123!\",\n  \"nama_lengkap\": \"Ahmad Fauzi\",\n  \"username\": \"{{reg_username}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Mendaftarkan pengguna baru dengan sanitasi email disposable dan validasi Zod."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate email & username unik tiap test agar tidak terjadi 409 Conflict",
                  "const rand = Date.now().toString().slice(-6) + Math.floor(Math.random() * 900 + 100);",
                  "const dynEmail = 'worker.' + rand + '@cepat.com';",
                  "const dynUsername = 'worker_' + rand;",
                  "pm.variables.set('reg_email', dynEmail);",
                  "pm.collectionVariables.set('reg_email', dynEmail);",
                  "pm.variables.set('reg_username', dynUsername);",
                  "pm.collectionVariables.set('reg_username', dynUsername);",
                  "console.log('Registering with:', dynEmail, dynUsername);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Pendaftaran berhasil\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login (Otomatis Simpan Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data?.session?.access_token) {",
                  "    pm.collectionVariables.set('auth_token', response.data.session.access_token);",
                  "    console.log('Token berhasil disimpan ke variable auth_token:', response.data.session.access_token);",
                  "} else if (response.session?.access_token) {",
                  "    pm.collectionVariables.set('auth_token', response.session.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"andi@cepat.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login pengguna. Test script otomatis menangkap `access_token` dan menyimpannya ke variable collection `auth_token`."
          }
        },
        {
          "name": "Get Profil Saya (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Mengambil data profil pengguna yang sedang terautentikasi beserta role, saldo, dan skills."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Membatalkan sesi Supabase Auth."
          }
        }
      ]
