          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && Array.isArray(response.data) && response.data.length > 0) {",
                  "    const roomId = response.data[0].id_chat_room || response.data[0].id;",
                  "    if (roomId) {",
                  "        pm.collectionVariables.set('chat_room_id', roomId);",
                  "        console.log('Chat Room ID berhasil disimpan ke variable chat_room_id:', roomId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
